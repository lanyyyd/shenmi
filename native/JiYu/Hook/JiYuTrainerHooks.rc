    PUSHBUTTON      "不理会",IDNO,252,51,50,14
    LTEXT           "意外与主程序失去联系，是否重启主程序？",IDC_STATIC,23,25,153,8
    DEFPUSHBUTTON   "重启主程序",IDC_RESTART,118,51,74,14
END

