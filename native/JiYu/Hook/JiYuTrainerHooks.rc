//
// Dialog
//

IDD_MSGCT DIALOGEX 0, 0, 291, 63
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_STATUS_LIST,19,0,272,50,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "备用杀死",IDC_KILL,0,0,20,35,BS_MULTILINE
    PUSHBUTTON      "▲",IDC_SHIDE,0,33,20,17
    CONTROL         IDB_BITMAP_RED,IDC_STATUS_RUNNING,"Static",SS_BITMAP,25,52,11,10
    CONTROL         IDB_BITMAP_GRRY,IDC_STATUS_LOCK,"Static",SS_BITMAP,40,52,11,10
    CONTROL         IDB_BITMAP_GRRY,IDC_STATUS_FAKEFULL,"Static",SS_BITMAP,54,52,11,10
    LTEXT           "JiYuTrainer V1.6",IDC_STATIC,232,51,53,8,WS_DISABLED
END

IDD_OPASK DIALOGEX 0, 0, 367, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST | WS_EX_APPWINDOW
CAPTION "JiYu Killer 防护警告"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "允许启动",IDYES,236,91,58,14
    DEFPUSHBUTTON   "拒绝",IDNO,297,91,63,14
    LTEXT           "极域电子教室 试图启动以下程序，请确认这是不是您的意愿。您是否允许其继续启动？",IDC_STATIC,23,18,307,8
    EDITTEXT        IDC_EDIT_OP_PATH,75,36,267,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_OP_PARARM,75,52,267,14,ES_AUTOHSCROLL
    LTEXT           "程序路径：",IDC_STATIC,23,39,41,8
    LTEXT           "命令行参数：",IDC_STATIC,23,55,49,8
    CONTROL         "拒绝极域继续运行任何程序",IDC_CHECK_BANDALL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,89,112,10
    CONTROL         "此操作一律允许",IDC_CHECK_ALOW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,77,72,10
END

IDD_OUTCTL DIALOGEX 0, 0, 309, 72
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "JiYu Killer 防御警告"
