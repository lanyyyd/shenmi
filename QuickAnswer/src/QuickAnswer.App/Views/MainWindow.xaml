<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuickAnswer.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource QaPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏（ExtendsContentIntoTitleBar，系统按钮浮在右侧） ===== -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Padding="16,0,150,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource QaAccentBrush}">
                    <TextBlock Text="Q" FontSize="13" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="QuickAnswer" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource QaTextBrush}" VerticalAlignment="Center" />
                <Button x:Name="SettingsBtn" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                        Width="30" Height="28" Background="Transparent" BorderThickness="0"
                        Padding="0" Margin="6,0,0,0"
                        Click="OnSettingsClick" ToolTipService.ToolTip="设置" />
            </StackPanel>
        </Grid>

        <!-- ===== 内容 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
            <StackPanel Spacing="12">

                <!-- 状态条 -->
                <Border Background="#FFF0F7FF" BorderBrush="#FFDCEAFB" BorderThickness="1"
                        CornerRadius="8" Padding="14,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF9CA3AF" />
                            <TextBlock x:Name="StatusLabel" Text="未开始" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#FF166534" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="RegionLabel" Text="未框选区域" FontSize="10"
                                   Foreground="{StaticResource QaSubBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 答案预览卡 -->
                <Border Background="#FF0F172A" CornerRadius="12" Height="164" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PreviewLetter" Grid.Column="0" Text="—" FontSize="72" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,14,0">
                            <TextBlock Text="正确答案" FontSize="9.5" Foreground="#FF64748B" />
                            <TextBlock x:Name="PreviewAnswer" Text="等待识别…" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#FFF1F5F9" TextWrapping="Wrap" MaxLines="2" />
                            <TextBlock x:Name="PreviewDetail" Text="" FontSize="9.5" Foreground="#FF64748B"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border x:Name="SourceBadge" Background="#FF1E293B" CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <TextBlock x:Name="SourceText" Text="待命" FontSize="8.5" Foreground="#FF94A3B8" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 模型 -->
                <Grid>
                    <TextBlock Text="模型" FontSize="11" Foreground="{StaticResource QaSubBrush}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="ModelBox" Width="248" Height="34" HorizontalAlignment="Right"
                              DisplayMemberPath="Name" SelectionChanged="OnModelChanged" />
                </Grid>

                <!-- 透明度 -->
                <Grid>
                    <TextBlock Text="悬浮窗透明度" FontSize="11" Foreground="{StaticResource QaSubBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                                VerticalAlignment="Center">
                        <Slider x:Name="OpacitySlider" Width="176" Minimum="10" Maximum="100" Value="30"
                                StepFrequency="5" ValueChanged="OnOpacityChanged" />
                        <TextBlock x:Name="OpacityLabel" Text="30%" FontSize="11" Width="36"
                                   TextAlignment="Right" Foreground="{StaticResource QaTextBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 开关区 -->
                <StackPanel Spacing="10" Margin="0,2,0,2">
                    <Grid>
                        <TextBlock Text="自动循环" FontSize="12" Foreground="{StaticResource QaTextBrush}"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="AutoLoopSwitch" HorizontalAlignment="Right" OnContent=""
                                      OffContent="" Toggled="OnAutoLoopToggled" />
                    </Grid>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="隐蔽模式" FontSize="12" Foreground="{StaticResource QaTextBrush}" />
                            <TextBlock Text="不显示悬浮窗，答案直接标在题目上" FontSize="9.5"
                                       Foreground="{StaticResource QaMutedBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StealthSwitch" HorizontalAlignment="Right" OnContent=""
                                      OffContent="" Toggled="OnStealthToggled" />
                    </Grid>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="防截屏" FontSize="12" Foreground="{StaticResource QaTextBrush}" />
                            <TextBlock Text="窗口不出现在截图与录屏中" FontSize="9.5"
                                       Foreground="{StaticResource QaMutedBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ProtectSwitch" HorizontalAlignment="Right" OnContent=""
                                      OffContent="" Toggled="OnProtectToggled" />
                    </Grid>
                </StackPanel>

                <!-- 操作按钮 -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="框选区域" Height="42" HorizontalAlignment="Stretch"
                            Click="OnSelectRegionClick" />

                    <Button Grid.Column="1" Content="立即识别" Height="42" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" Click="OnRecognizeClick" />
                </Grid>

                <!-- 底部统计 -->
                <Grid Margin="0,4,0,0">
                    <TextBlock x:Name="StatsLabel" Text="今日 0 题 · 命中 0" FontSize="10"
                               Foreground="{StaticResource QaMutedBrush}" />
                    <TextBlock Text="Alt+Q 识别 · Alt+D 隐蔽 · Alt+W 循环" FontSize="9.5"
                               Foreground="#FFC0C6D0" HorizontalAlignment="Right" />
                </Grid>

                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="2" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
