<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuickAnswer.App.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource QaPageBrush}">
        <StackPanel Width="356" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- 品牌区 -->
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,34">
                <Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource QaAccentBrush}">
                    <TextBlock Text="Q" FontSize="25" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="QuickAnswer" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource QaTextBrush}" />
                    <TextBlock Text="屏幕取词 · 秒出答案" FontSize="11.5"
                               Foreground="{StaticResource QaSubBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- 账号 -->
            <TextBlock Text="账号" FontSize="11.5" Foreground="{StaticResource QaSubBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="UserBox" PlaceholderText="请输入用户名" Height="42"
                     KeyDown="OnKeyDown" />

            <!-- 密码 -->
            <TextBlock Text="密码" FontSize="11.5" Foreground="{StaticResource QaSubBrush}" Margin="0,16,0,6" />
            <PasswordBox x:Name="PassBox" PlaceholderText="请输入密码" Height="42"
                         KeyDown="OnKeyDown" />

            <!-- 服务器 -->
            <TextBlock Text="服务器地址" FontSize="11.5" Foreground="{StaticResource QaSubBrush}" Margin="0,16,0,6" />
            <TextBox x:Name="ServerBox" PlaceholderText="http://127.0.0.1:8000" Height="42"
                     KeyDown="OnKeyDown" />

            <!-- 错误提示 -->
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource QaErrorBrush}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />

            <!-- 登录按钮 -->
            <Button x:Name="LoginBtn" Content="登 录" Height="42" Margin="0,22,0,0"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnLoginClick" />

            <!-- 状态 -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,18,0,0">
                <ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False" />
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource QaMutedBrush}"
                           VerticalAlignment="Center" Text="未连接" />
            </StackPanel>

            <TextBlock Text="v1.0.0" FontSize="10" Foreground="#FFC0C6D0"
                       HorizontalAlignment="Center" Margin="0,26,0,0" />
        </StackPanel>
    </Grid>
</Window>
