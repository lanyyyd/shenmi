<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SteamEyaWinUI.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SteamEYA 登录">

    <Grid x:Name="RootGrid" Background="{ThemeResource AuroraPageBackgroundBrush}">
        <StackPanel
            Width="380"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock Text="SteamEYA" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="一体化上号器 · 统一登录"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- 网络状态 -->
            <Border
                Padding="10,6"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock x:Name="NetworkText" Text="正在检测网络…" />
            </Border>

            <!-- 登录 / 注册切换 -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <RadioButton x:Name="TabLogin" Content="登录" IsChecked="True" GroupName="authTab" Checked="OnTabChanged" />
                <RadioButton x:Name="TabRegister" Content="注册" GroupName="authTab" Checked="OnTabChanged" />
            </StackPanel>

            <TextBox x:Name="UserBox" PlaceholderText="用户名" />
            <PasswordBox x:Name="PassBox" PlaceholderText="密码（至少 6 位）" />
            <TextBox x:Name="NickBox" PlaceholderText="昵称（选填）" Visibility="Collapsed" />
            <!-- 注册邀请码：与聊天室网页端注册一致，后台开启必填时用于校验 -->
            <TextBox x:Name="InviteBox" PlaceholderText="邀请码（注册必填，向管理员索取）" Visibility="Collapsed" />

            <!-- 记住密码：默认勾选，勾选后下次打开自动回填账号密码 -->
            <CheckBox x:Name="RememberBox" Content="记住密码" IsChecked="True" />

            <Button x:Name="AuthButton" Content="登 录" HorizontalAlignment="Stretch" Click="OnAuthClick" />

            <InfoBar x:Name="LoginInfoBar" IsOpen="False" IsClosable="True" />

            <!-- 离线入口：仅无网络时可用 -->
            <Button
                x:Name="OfflineButton"
                Content="进入离线模式（局域网聊天）"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed"
                Click="OnOfflineClick" />
        </StackPanel>
    </Grid>
</Window>