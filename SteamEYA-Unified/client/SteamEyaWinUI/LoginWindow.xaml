<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SteamEyaWinUI.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="茶π·次元口袋">

    <Grid x:Name="RootGrid" Background="{ThemeResource AuroraPageBackgroundBrush}">
        <StackPanel
            Width="380"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <!-- 品牌标志：宽度不超过下方登录按钮，等比缩放；透明底，浅色渐变背景上黑金清晰。 -->
            <Image
                x:Name="BrandLogo"
                MaxWidth="300"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/LoginLogo.png"
                Stretch="Uniform" />
            <TextBlock
                Text="一体化上号器 · 统一登录"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- 网络状态 -->
            <Border
                Padding="10,6"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock x:Name="NetworkText" Text="正在检测网络…" />
            </Border>

            <!-- 登录 / 注册：胶囊分段控件，选中项实色圆角，未选中透明 -->
            <Border
                Padding="4"
                Background="#1F000000"
                CornerRadius="14">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="TabLoginButton"
                        Grid.Column="0"
                        Height="38"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnTabClick"
                        Content="登录"
                        CornerRadius="10"
                        FontSize="14" />
                    <Button
                        x:Name="TabRegisterButton"
                        Grid.Column="1"
                        Height="38"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnTabClick"
                        Content="注册"
                        CornerRadius="10"
                        FontSize="14" />
                </Grid>
            </Border>

            <TextBox x:Name="UserBox" PlaceholderText="用户名" />
            <PasswordBox x:Name="PassBox" PlaceholderText="密码（至少 6 位）" />
            <TextBox x:Name="NickBox" PlaceholderText="昵称（选填）" Visibility="Collapsed" />
            <!-- 注册邀请码：与聊天室网页端注册一致，后台开启必填时用于校验 -->
            <TextBox x:Name="InviteBox" PlaceholderText="邀请码（注册必填，向管理员索取）" Visibility="Collapsed" />

            <!-- 记住密码：默认勾选，勾选后下次打开自动回填账号密码 -->
            <CheckBox x:Name="RememberBox" Content="记住密码" IsChecked="True" />

            <Button
                x:Name="AuthButton"
                Height="46"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource AuroraAccentGradientBrush}"
                BorderThickness="0"
                Click="OnAuthClick"
                Content="登 录"
                CornerRadius="12"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="White" />

            <InfoBar x:Name="LoginInfoBar" IsOpen="False" IsClosable="True" />

            <!-- 离线入口：仅无网络时可用 -->
            <Button
                x:Name="OfflineButton"
                Content="进入离线模式（局域网聊天）"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed"
                Click="OnOfflineClick" />
        </StackPanel>
    </Grid>
</Window>