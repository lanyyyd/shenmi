<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SteamEyaWinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Aurora 冰态果冻基础色：运行时由 UiColorService 按主题和用户颜色覆盖。 -->
            <LinearGradientBrush x:Key="AuroraPageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFF0F5" Offset="0" />
                <GradientStop Color="#FFFFE4E1" Offset="0.42" />
                <GradientStop Color="#FFE6E6FA" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AuroraAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFEC4899" Offset="0" />
                <GradientStop Color="#FF8B5CF6" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="AuroraGlassBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="AuroraGlassStrongBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="AuroraGlassButtonBrush" Color="#7AFFFFFF" />
            <SolidColorBrush x:Key="AuroraGlassInputBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="AuroraGlassBorderBrush" Color="#8FFFFFFF" />
            <SolidColorBrush x:Key="AuroraPaneBrush" Color="#70FFFFFF" />
            <SolidColorBrush x:Key="AuroraTableHeaderBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="AuroraNavHoverBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="AuroraNavSelectedBrush" Color="#32EC4899" />
            <SolidColorBrush x:Key="AuroraPillBrush" Color="#38EC4899" />
            <SolidColorBrush x:Key="AuroraTextHeadingBrush" Color="#FF1E1B4B" />
            <SolidColorBrush x:Key="AuroraTextBodyBrush" Color="#FF312E81" />
            <SolidColorBrush x:Key="AuroraTextMutedBrush" Color="#FF6366F1" />

            <SolidColorBrush x:Key="CustomUiBrush" Color="#EC4899" />
            <SolidColorBrush x:Key="CustomUiMutedBrush" Color="#32EC4899" />
            <SolidColorBrush x:Key="CustomUiPageBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="CustomUiCardBrush" Color="#70FFFFFF" />
            <SolidColorBrush x:Key="CustomUiDialogBrush" Color="#FFF8F6FF" />
            <SolidColorBrush x:Key="CustomUiButtonBrush" Color="#7AFFFFFF" />
            <SolidColorBrush x:Key="CustomUiBorderBrush" Color="#8FFFFFFF" />
            <!-- 所有文本输入控件统一跟随应用主题，避免 WinUI 深色主题的聚焦态切到黑底。 -->
            <StaticResource x:Key="TextControlBackground" ResourceKey="AuroraGlassInputBrush" />
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="AuroraGlassInputBrush" />
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="AuroraGlassInputBrush" />
            <StaticResource x:Key="TextControlButtonBackground" ResourceKey="CustomUiButtonBrush" />
            <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="CustomUiMutedBrush" />
            <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="CustomUiBrush" />
            <StaticResource x:Key="TextControlButtonBorderBrush" ResourceKey="CustomUiBorderBrush" />
            <StaticResource x:Key="TextControlButtonBorderBrushPointerOver" ResourceKey="CustomUiBorderBrush" />
            <StaticResource x:Key="TextControlButtonBorderBrushPressed" ResourceKey="CustomUiBrush" />
            <StaticResource x:Key="TextControlButtonForeground" ResourceKey="AuroraTextBodyBrush" />
            <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="TextControlButtonForegroundPressed" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="CustomUiButtonBrush" />
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="CustomUiMutedBrush" />
            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="CustomUiMutedBrush" />
            <StaticResource x:Key="ComboBoxBackgroundFocused" ResourceKey="CustomUiButtonBrush" />
            <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="CustomUiButtonBrush" />
            <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="CustomUiBrush" />
            <StaticResource x:Key="ComboBoxBackgroundBorderBrushUnfocused" ResourceKey="CustomUiBorderBrush" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="CustomUiBorderBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="CustomUiBorderBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="CustomUiBrush" />
            <StaticResource x:Key="ComboBoxForeground" ResourceKey="AuroraTextBodyBrush" />
            <StaticResource x:Key="ComboBoxForegroundPointerOver" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ComboBoxForegroundPressed" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="AuroraGlassStrongBrush" />
            <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="AuroraGlassBorderBrush" />
            <StaticResource x:Key="ComboBoxDropDownForeground" ResourceKey="AuroraTextBodyBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="CustomUiMutedBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="CustomUiBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="CustomUiMutedBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="CustomUiBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="CustomUiBrush" />
            <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="AuroraTextBodyBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="AuroraTextHeadingBrush" />
            <StaticResource x:Key="ContentDialogBackground" ResourceKey="CustomUiDialogBrush" />
            <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="CustomUiBorderBrush" />

            <!-- 全局控件圆角，后续新增控件默认沿用主题 UI 的圆角。 -->
            <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>

            <!-- 卡片容器 -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AuroraGlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="AuroraGlassButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AuroraGlassButtonBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="UiTintComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Background" Value="{ThemeResource CustomUiButtonBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CustomUiBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Foreground" Value="{ThemeResource AuroraTextBodyBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="UiTintComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AuroraTextBodyBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Background" Value="{ThemeResource CustomUiButtonBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CustomUiBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AuroraTextBodyBrush}" />
                <Setter Property="Background" Value="{ThemeResource AuroraGlassStrongBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AuroraGlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ThemedDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="ThemedDialogCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource AuroraGlassButtonStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,7" />
            </Style>
            <Style TargetType="ContentDialog">
                <Setter Property="Background" Value="{ThemeResource CustomUiDialogBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CustomUiBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource ThemedDialogPrimaryButtonStyle}" />
                <Setter Property="CloseButtonStyle" Value="{StaticResource ThemedDialogCloseButtonStyle}" />
            </Style>

            <!-- 页面标题 -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource AuroraTextHeadingBrush}" />
            </Style>

            <!-- 页面副标题 -->
            <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AuroraTextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 卡片小节标题 -->
            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AuroraTextHeadingBrush}" />
            </Style>

            <!-- 字段标签（说明文字） -->
            <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AuroraTextMutedBrush}" />
            </Style>

            <!-- 字段值 -->
            <Style x:Key="FieldValueTextStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
