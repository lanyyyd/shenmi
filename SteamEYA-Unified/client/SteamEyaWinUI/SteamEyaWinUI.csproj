<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0：net8.0 的 Native AOT 有 WinUI GC 挂死缺陷（dotnet/runtime#104582，.NET 9+ 才修复）。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SteamEyaWinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 版本号：本地默认 1.0.0；CI 用 -p:Version=1.0.<构建序号> 注入，
         使程序集 InformationalVersion 与安装包版本一致，客户端才能正确比较新旧版本。 -->
    <Version>1.0.0</Version>
    <InformationalVersion>v$(Version)</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 自定义 Program.Main：绕过 XAML 生成的入口，便于控制 COM 初始化时机（见 Program.cs）。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Native AOT 发布（dotnet publish -r win-x64 -p:Platform=x64 时生效）。
         按 Windows App SDK 指引，PublishAot 需写在项目文件里以便还原期生效。 -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- CsWinRT 源生成器可能产出 unsafe 代码（CsWinRT#1721）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 对跨 WinRT ABI 但未标 partial 的类型给出编译期警告。 -->
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- 禁止反射式 System.Text.Json，意外引入时在开发期即失败而不是 AOT 产物上炸。 -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- 自包含：把 Windows App SDK 运行时 DLL 一并打包到发布目录，
         用户电脑无需安装 Windows App Runtime，配合 Native AOT 实现真正零运行时依赖。 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 登录页品牌标志（神秘の魔法武器书法 logo，透明底）。 -->
    <Content Include="Assets\LoginLogo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows App SDK 通知栈的字符串资源 DLL（34KB，只依赖 KERNEL32 + UCRT）。
         WinUI 组件包的自包含部署不包含它，AppNotificationManager.Register() 会以
         0x8007007E「找不到指定的模块」失败，表现是系统通知完全不可用、且不抛到 UI。
         取自 Microsoft.WindowsAppSDK.Runtime 2.2.0 的 Microsoft.WindowsAppRuntime.2.msix 根目录。 -->
    <Content Include="..\..\..\native\WindowsAppRuntime\Microsoft.WindowsAppRuntime.Insights.Resource.dll">
      <Link>Microsoft.WindowsAppRuntime.Insights.Resource.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 内置极域助手：原版 JiYuTrainer 1.7.6（MIT，未修改，见 third_party\JiYuTrainer\SOURCE.txt）。
         客户端只负责启动/显示/停止它，注入与功能全部由原版自带界面完成。 -->
    <Content Include="..\..\..\third_party\JiYuTrainer\JiYuTrainer.exe">
      <Link>jiyu\JiYuTrainer.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 界面语言包：随发布拷到 Languages\ 供贡献者/用户增改，并内嵌一份作发布漏拷时的保底（见 LanguageCatalog）。
         显式 LogicalName 既让清单名稳定（SteamEyaWinUI.Languages.<code>.json），也避免 en/zh-Hant 被当作附属语言 culture。 -->
    <Content Include="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Languages\*.json">
      <LogicalName>SteamEyaWinUI.Languages.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- 只引用 WinUI 组件包（自动带 Foundation/Base/InteractiveExperiences），
         避免 WindowsAppSDK 元包拖入 onnxruntime/DirectML/AI 等无用载荷（约 40 MB）。
         自包含模式下 WinUI 组件包自带运行时 DLL，无需 Runtime 包。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
  </ItemGroup>

  <!-- 构建期校验：这个 DLL 丢了系统通知会静默退化成「注册失败」，只有真机点测试通知才发现。
       放在发布流程里直接失败，避免升级 WindowsAppSDK 后又悄悄坏掉。 -->
  <Target Name="VerifyWindowsAppRuntimeResource" AfterTargets="Publish">
    <Error
      Condition="!Exists('$(PublishDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll')"
      Text="发布目录缺少 Microsoft.WindowsAppRuntime.Insights.Resource.dll，系统通知将因 0x8007007E 失效。" />
  </Target>

  <!-- workaround：无打包 WinUI 应用 dotnet publish 时不会复制 PRI 资源索引文件，
       缺少它会在启动时抛 XamlParseException。 -->
  <Target Name="IncludeWinUIPriInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri" RelativePath="$(TargetName).pri" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
