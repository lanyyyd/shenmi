<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SteamEyaWinUI.Views.AssistInviteToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="18,14,18,4" Spacing="4">
            <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock
                x:Name="BodyText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ProgressBar
            x:Name="CountdownBar"
            Grid.Row="1"
            Margin="18,6,18,0"
            VerticalAlignment="Top"
            Maximum="100"
            Value="100" />

        <StackPanel
            Grid.Row="2"
            Padding="18,10,18,14"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">
            <Button x:Name="RejectBtn" Click="OnRejectClick" />
            <Button x:Name="AcceptBtn" Style="{StaticResource AccentButtonStyle}" Click="OnAcceptClick" />
        </StackPanel>
    </Grid>
</Window>
