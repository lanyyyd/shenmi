<Page
    x:Class="SteamEyaWinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <StackPanel MaxWidth="820" Spacing="14" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock
                    Text="{x:Bind Strings.Get('Settings_Title'), Mode=OneWay}"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Text="{x:Bind Strings.Get('Settings_Subtitle'), Mode=OneWay}"
                    Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- 语言：用 ComboBox 而非堆叠单选，既紧凑（避免页面出现多余滚动条）又适配可增长的语言列表 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Language_Section'), Mode=OneWay}"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Language_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- 语言自称名不随界面语言变化；选项在 code-behind 按已加载语言包动态生成 -->
                    <ComboBox
                        x:Name="LanguageComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        SelectionChanged="LanguageComboBox_SelectionChanged" />
                </Grid>
            </Border>

            <!-- 主题 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Theme_Section'), Mode=OneWay}"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Theme_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <ComboBox
                            x:Name="ThemeComboBox"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Tag="Default" Content="{x:Bind Strings.Get('Settings_Theme_System'), Mode=OneWay}" />
                            <ComboBoxItem Tag="Light" Content="{x:Bind Strings.Get('Settings_Theme_Light'), Mode=OneWay}" />
                            <ComboBoxItem Tag="Dark" Content="{x:Bind Strings.Get('Settings_Theme_Dark'), Mode=OneWay}" />
                            <ComboBoxItem Tag="Custom" Content="{x:Bind Strings.Get('Settings_Theme_Custom'), Mode=OneWay}" />
                        </ComboBox>
                        <!-- 仅在「自定义」主题下可见：挑主题色 / 复位主题色 -->
                        <Button
                            x:Name="ThemeColorButton"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    x:Name="ThemeColorSwatch"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource AuroraGlassBorderBrush}"
                                    Background="{ThemeResource CustomUiBrush}" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Theme_Color_Button'), Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8">
                                        <ColorPicker
                                            x:Name="ThemeColorPicker"
                                            IsAlphaEnabled="False"
                                            IsAlphaSliderVisible="False"
                                            IsAlphaTextInputVisible="False"
                                            ColorChanged="ThemeColorPicker_ColorChanged" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            MinWidth="0"
                                            Click="ResetThemeColorButton_Click">
                                            <TextBlock Text="{x:Bind Strings.Get('Settings_Theme_Color_Reset'), Mode=OneWay}" />
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 自定义背景：图片（含 GIF）或视频（静音循环），二选一 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Background_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Background_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="CustomBackgroundToggle"
                        Header="{x:Bind Strings.Get('Settings_Background_Enable'), Mode=OneWay}"
                        OnContent="{x:Null}"
                        OffContent="{x:Null}"
                        Toggled="CustomBackgroundToggle_Toggled" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="CustomBackgroundFileNameText"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="ChooseCustomBackgroundButton"
                                Click="ChooseCustomBackgroundButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Settings_Background_Choose'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ClearCustomBackgroundButton"
                                Click="ClearCustomBackgroundButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Settings_Background_Clear'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="CustomBackgroundOpacitySlider"
                            Grid.Column="0"
                            Header="{x:Bind Strings.Get('Settings_Background_Opacity'), Mode=OneWay}"
                            Minimum="0.1"
                            Maximum="0.9"
                            StepFrequency="0.05"
                            Value="0.4"
                            ValueChanged="CustomBackgroundOpacitySlider_ValueChanged" />
                        <Button
                            x:Name="ResetCustomBackgroundOpacityButton"
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            VerticalAlignment="Bottom"
                            Click="ResetCustomBackgroundOpacityButton_Click">
                            <TextBlock Text="{x:Bind Strings.Get('Settings_Background_Opacity_Reset'), Mode=OneWay}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Steam 安装路径：上号用的 Steam；装有多个 Steam 时可手动指定要用哪一个 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_SteamPath_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_SteamPath_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="SteamPathText"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="ChangeSteamPathButton"
                            Grid.Column="1"
                            Click="ChangeSteamPathButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Btn_ChangeSteamPath'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 百宝箱·多线程下载：默认保存目录与并发线程数 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Download_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Download_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Download_Dir'), Mode=OneWay}"
                            Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="DownloadDirText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DownloadDirButton" Click="DownloadDirButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Download_Dir_Change'), Mode=OneWay}" />
                            </Button>
                            <Button x:Name="DownloadDirResetButton" Click="DownloadDirResetButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Download_Reset'), Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Download_Thread'), Mode=OneWay}"
                            Style="{StaticResource FieldLabelTextStyle}" />
                        <NumberBox
                            x:Name="DownloadThreadBox"
                            Grid.Column="1"
                            Width="120"
                            Minimum="1"
                            Maximum="256"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="DownloadThreadBox_ValueChanged" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Download_Thread_Desc'), Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 截图：全局热键 + 框选后复制/另存为 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Screenshot_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Screenshot_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Screenshot_Hotkey'), Mode=OneWay}"
                            Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox
                            x:Name="ScreenshotHotkeyBox"
                            Grid.Column="1"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            KeyDown="ScreenshotHotkeyBox_KeyDown" />
                        <Button
                            x:Name="ScreenshotRecordButton"
                            Grid.Column="2"
                            Click="ScreenshotRecordButton_Click">
                            <TextBlock Text="{x:Bind Strings.Get('Settings_Screenshot_Record'), Mode=OneWay}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 离线聊天同步：手动把离线期间的消息推送到云端 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_ChatSync_Section'), Mode=OneWay}"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_ChatSync_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="ChatSyncButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="ChatSyncButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE895;" FontSize="14" />
                            <TextBlock Text="{x:Bind Strings.Get('Settings_ChatSync_Btn'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 聊天室运行模式：自动 / 完整版（内嵌网页版）/ 原生版 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_ChatMode_Section'), Mode=OneWay}"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_ChatMode_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="ChatModeComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        SelectionChanged="ChatModeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="Auto" Content="{x:Bind Strings.Get('Settings_ChatMode_Auto'), Mode=OneWay}" />
                        <ComboBoxItem Tag="Web" Content="{x:Bind Strings.Get('Settings_ChatMode_Web'), Mode=OneWay}" />
                        <ComboBoxItem Tag="Native" Content="{x:Bind Strings.Get('Settings_ChatMode_Native'), Mode=OneWay}" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 数据 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Data_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Data_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="DataFolderPathText"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="OpenDataFolderButton"
                            Grid.Column="1"
                            Click="OpenDataFolderButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Btn_OpenDataFolder'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Notify_Test_Desc'), Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="NotifyTestButton"
                            Grid.Column="1"
                            Click="NotifyTestButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7E7;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Notify_Test'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
