<Page
    x:Class="SteamEyaWinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <StackPanel MaxWidth="820" Spacing="14" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock
                    Text="{x:Bind Strings.Get('Settings_Title'), Mode=OneWay}"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Text="{x:Bind Strings.Get('Settings_Subtitle'), Mode=OneWay}"
                    Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- 语言：用 ComboBox 而非堆叠单选，既紧凑（避免页面出现多余滚动条）又适配可增长的语言列表 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Language_Section'), Mode=OneWay}"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Language_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- 语言自称名不随界面语言变化；选项在 code-behind 按已加载语言包动态生成 -->
                    <ComboBox
                        x:Name="LanguageComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        SelectionChanged="LanguageComboBox_SelectionChanged" />
                </Grid>
            </Border>

            <!-- 主题 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Theme_Section'), Mode=OneWay}"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Theme_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <ComboBox
                            x:Name="ThemeComboBox"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Tag="Default" Content="{x:Bind Strings.Get('Settings_Theme_System'), Mode=OneWay}" />
                            <ComboBoxItem Tag="Light" Content="{x:Bind Strings.Get('Settings_Theme_Light'), Mode=OneWay}" />
                            <ComboBoxItem Tag="Dark" Content="{x:Bind Strings.Get('Settings_Theme_Dark'), Mode=OneWay}" />
                            <ComboBoxItem Tag="Custom" Content="{x:Bind Strings.Get('Settings_Theme_Custom'), Mode=OneWay}" />
                        </ComboBox>
                        <!-- 仅在「自定义」主题下可见：挑主题色 / 复位主题色 -->
                        <Button
                            x:Name="ThemeColorButton"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    x:Name="ThemeColorSwatch"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource AuroraGlassBorderBrush}"
                                    Background="{ThemeResource CustomUiBrush}" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Theme_Color_Button'), Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8">
                                        <ColorPicker
                                            x:Name="ThemeColorPicker"
                                            IsAlphaEnabled="False"
                                            IsAlphaSliderVisible="False"
                                            IsAlphaTextInputVisible="False"
                                            ColorChanged="ThemeColorPicker_ColorChanged" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            MinWidth="0"
                                            Click="ResetThemeColorButton_Click">
                                            <TextBlock Text="{x:Bind Strings.Get('Settings_Theme_Color_Reset'), Mode=OneWay}" />
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 自定义背景：图片（含 GIF）或视频（静音循环），二选一 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Background_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Background_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="CustomBackgroundToggle"
                        Header="{x:Bind Strings.Get('Settings_Background_Enable'), Mode=OneWay}"
                        OnContent="{x:Null}"
                        OffContent="{x:Null}"
                        Toggled="CustomBackgroundToggle_Toggled" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="CustomBackgroundFileNameText"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="ChooseCustomBackgroundButton"
                                Click="ChooseCustomBackgroundButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Settings_Background_Choose'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ClearCustomBackgroundButton"
                                Click="ClearCustomBackgroundButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Settings_Background_Clear'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="CustomBackgroundOpacitySlider"
                            Grid.Column="0"
                            Header="{x:Bind Strings.Get('Settings_Background_Opacity'), Mode=OneWay}"
                            Minimum="0.1"
                            Maximum="0.9"
                            StepFrequency="0.05"
                            Value="0.4"
                            ValueChanged="CustomBackgroundOpacitySlider_ValueChanged" />
                        <Button
                            x:Name="ResetCustomBackgroundOpacityButton"
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            VerticalAlignment="Bottom"
                            Click="ResetCustomBackgroundOpacityButton_Click">
                            <TextBlock Text="{x:Bind Strings.Get('Settings_Background_Opacity_Reset'), Mode=OneWay}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 更新站点：可选直连或代理站，手动检测当前选择站点延迟 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_UpdateProxy_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_UpdateProxy_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="UpdateProxyComboBox"
                            Grid.Column="0"
                            SelectionChanged="UpdateProxyComboBox_SelectionChanged">
                            <ComboBoxItem Tag="direct" Content="{x:Bind Strings.Get('Settings_UpdateProxy_Direct'), Mode=OneWay}" />
                            <ComboBoxItem Tag="gh-proxy.org" Content="{x:Bind Strings.Get('Settings_UpdateProxy_GhProxyOrg'), Mode=OneWay}" />
                            <ComboBoxItem Tag="v4.gh-proxy.org" Content="{x:Bind Strings.Get('Settings_UpdateProxy_GhProxyOrgV4'), Mode=OneWay}" />
                            <ComboBoxItem Tag="v6.gh-proxy.org" Content="{x:Bind Strings.Get('Settings_UpdateProxy_GhProxyOrgV6'), Mode=OneWay}" />
                            <ComboBoxItem Tag="cdn.gh-proxy.org" Content="{x:Bind Strings.Get('Settings_UpdateProxy_GhProxyOrgCdn'), Mode=OneWay}" />
                        </ComboBox>
                        <Button
                            x:Name="UpdateProxyLatencyButton"
                            Grid.Column="1"
                            Click="UpdateProxyLatencyButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Settings_UpdateProxy_LatencyButton'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_UpdateProxy_LatencyButton'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Steam 安装路径：上号用的 Steam；装有多个 Steam 时可手动指定要用哪一个 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_SteamPath_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_SteamPath_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="SteamPathText"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="ChangeSteamPathButton"
                            Grid.Column="1"
                            Click="ChangeSteamPathButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Btn_ChangeSteamPath'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CS2 设置同步（issue #10）：登录时把来源账号的准星/灵敏度/键位等强推到目标账号的 Steam 云 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind Strings.Get('Settings_Cs2Sync_Section'), Mode=OneWay}"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                Text="{x:Bind Strings.Get('Settings_Cs2Sync_Desc'), Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="Cs2SyncToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            OnContent="{x:Null}"
                            OffContent="{x:Null}"
                            Toggled="Cs2SyncToggle_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Cs2Sync_Source'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <AutoSuggestBox
                            x:Name="Cs2SyncSourceBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            QueryIcon="Find"
                            UpdateTextOnSelect="False"
                            PlaceholderText="{x:Bind Strings.Get('Settings_Cs2Sync_Source_Placeholder'), Mode=OneWay}"
                            TextChanged="Cs2SyncSourceBox_TextChanged"
                            QuerySubmitted="Cs2SyncSourceBox_QuerySubmitted"
                            GotFocus="Cs2SyncSourceBox_GotFocus"
                            LostFocus="Cs2SyncSourceBox_LostFocus" />
                        <Button
                            x:Name="Cs2SyncRefreshButton"
                            Grid.Column="2"
                            Click="Cs2SyncRefreshButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Common_Refresh'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="Cs2SyncPushNowButton"
                            Grid.Column="3"
                            Click="Cs2SyncPushNowButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Settings_Cs2Sync_PushNow_Tooltip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Cs2Sync_PushNow'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Cs2Sync_Note'), Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 数据 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Data_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Data_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="DataFolderPathText"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="OpenDataFolderButton"
                            Grid.Column="1"
                            Click="OpenDataFolderButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Btn_OpenDataFolder'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
