<Page
    x:Class="SteamEyaWinUI.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <Grid ColumnSpacing="24" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="FormPanel" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Strings.Get('Login_Title'), Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Login_Subtitle'), Mode=OneWay}"
                        Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <SelectorBar x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged">
                    <SelectorBarItem x:Name="RemoteModeItem" Text="{x:Bind Strings.Get('Login_Mode_Remote'), Mode=OneWay}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE753;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="ManualModeItem" Text="{x:Bind Strings.Get('Login_Mode_Manual'), Mode=OneWay}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="CredsModeItem" Text="{x:Bind Strings.Get('Login_Mode_Creds'), Mode=OneWay}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE72E;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <!-- 远程账号模式：从服务器获取账号并一键上号 -->
                <Border x:Name="RemotePanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Remote_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Login_Remote_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <!-- 未登录统一账号：登录 / 注册 -->
                        <StackPanel x:Name="RemoteAuthPanel" Spacing="14">
                            <TextBox
                                x:Name="RemoteUsernameBox"
                                Header="{x:Bind Strings.Get('Login_Label_UserName'), Mode=OneWay}"
                                PlaceholderText="{x:Bind Strings.Get('Login_Remote_Username_Placeholder'), Mode=OneWay}"
                                IsSpellCheckEnabled="False" />

                            <PasswordBox
                                x:Name="RemotePasswordBox"
                                Header="{x:Bind Strings.Get('Creds_Field_Password'), Mode=OneWay}"
                                PlaceholderText="{x:Bind Strings.Get('Login_Remote_Password_Placeholder'), Mode=OneWay}" />

                            <!-- 邀请码：与网页版注册共用后台开关，未开启必填时可留空 -->
                            <TextBox
                                x:Name="RemoteInviteBox"
                                Header="{x:Bind Strings.Get('Login_Remote_Invite_Label'), Mode=OneWay}"
                                PlaceholderText="{x:Bind Strings.Get('Login_Remote_Invite_Placeholder'), Mode=OneWay}"
                                IsSpellCheckEnabled="False" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="RemoteLoginButton"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,10"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="RemoteLoginButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72E;" FontSize="16" />
                                        <TextBlock Text="{x:Bind Strings.Get('Login_Remote_Btn_Login'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="RemoteRegisterButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,10"
                                    Click="RemoteRegisterButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                                        <TextBlock Text="{x:Bind Strings.Get('Login_Remote_Btn_Register'), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 已登录：获取账号并一键上号 -->
                        <StackPanel x:Name="RemoteGetAccountPanel" Spacing="14" Visibility="Collapsed">
                            <TextBlock
                                x:Name="RemoteWelcomeText"
                                Style="{StaticResource SectionTitleTextStyle}"
                                TextWrapping="Wrap" />

                            <Button
                                x:Name="RemoteGetAccountButton"
                                HorizontalAlignment="Stretch"
                                Padding="0,12"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="RemoteGetAccountButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Remote_Btn_Get'), Mode=OneWay}" FontSize="16" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="RemoteLogoutButton"
                                HorizontalAlignment="Stretch"
                                Padding="0,10"
                                Click="RemoteLogoutButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Login_Remote_Btn_Logout'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ManualPanel" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Manual_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBox
                            x:Name="AccountNameBox"
                            Header="{x:Bind Strings.Get('Login_Field_AccountName'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_AccountName_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False"
                            TextChanged="ManualCredentialBox_TextChanged"
                            KeyDown="AccountNameBox_KeyDown" />

                        <TextBox
                            x:Name="EyaTokenBox"
                            Height="150"
                            Header="{x:Bind Strings.Get('Login_Field_EyaToken'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_EyaToken_Placeholder'), Mode=OneWay}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            IsSpellCheckEnabled="False"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextChanged="ManualCredentialBox_TextChanged" />
                    </StackPanel>
                </Border>

                <!-- 账密模式（调试）：用账号密码登录 Steam，换取 EYA 令牌并存入历史。 -->
                <Border x:Name="CredsPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Creds_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Creds_Section_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <TextBox
                            x:Name="CredAccountNameBox"
                            Header="{x:Bind Strings.Get('Creds_Field_AccountName'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Creds_Field_AccountName_Placeholder'), Mode=OneWay}"
                            IsSpellCheckEnabled="False" />

                        <PasswordBox
                            x:Name="CredPasswordBox"
                            Header="{x:Bind Strings.Get('Creds_Field_Password'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Creds_Field_Password_Placeholder'), Mode=OneWay}" />

                        <Button
                            x:Name="CredFetchButton"
                            HorizontalAlignment="Stretch"
                            Padding="0,10"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CredFetchButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Creds_Btn_Fetch_Tip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Creds_Btn_Fetch'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 手动模式：主操作独占一行强调层级；下方「清除创意工坊订阅」独占一行。 -->
                <Grid x:Name="ActionButtonGrid" RowSpacing="12" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="LoginButton"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Stretch"
                        Padding="0,12"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="LoginButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D4;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_Login'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ClearWorkshopButton"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="ClearWorkshopButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ClearWorkshop_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ClearWorkshop'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 取消按钮仅忙碌时可见；OnBusyChanged 不禁用它，busy 期间始终可点。 -->
                <Button
                    x:Name="CancelButton"
                    HorizontalAlignment="Stretch"
                    Padding="0,10"
                    Visibility="Collapsed"
                    Click="CancelButton_Click"
                    ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_Cancel_Tip'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                        <TextBlock Text="{x:Bind Strings.Get('Common_Cancel'), Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind Strings.Get('Login_AccountInfo_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <PersonPicture
                            x:Name="AccountInfoAvatar"
                            Width="76"
                            Height="76" />
                        <TextBlock
                            x:Name="AccountInfoPersonaText"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind Strings.Get('Login_Label_UserName'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoUserText"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="1" Text="Steam64" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoSteamIdText"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="2" Text="{x:Bind Strings.Get('Login_Label_JwtExpires'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoExpiresText"
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                        <TextBlock Grid.Row="3" Text="{x:Bind Strings.Get('Login_Label_Availability'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="AccountInfoAvailabilityText"
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource FieldValueTextStyle}" />

                    </Grid>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>