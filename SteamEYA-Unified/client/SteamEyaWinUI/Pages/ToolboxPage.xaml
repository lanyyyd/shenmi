<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamEyaWinUI.Pages.ToolboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SteamEyaWinUI.Models"
    xmlns:loc="using:SteamEyaWinUI.Localization"
    NavigationCacheMode="Required"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <StackPanel MaxWidth="820" Spacing="14" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock
                    Text="{x:Bind Strings.Get('Toolbox_Title'), Mode=OneWay}"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Text="{x:Bind Strings.Get('Toolbox_Subtitle'), Mode=OneWay}"
                    Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- 多线程下载 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Toolbox_Download_Title'), Mode=OneWay}"
                            Style="{StaticResource SectionTitleTextStyle}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind Strings.Get('Toolbox_Download_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="UrlBox"
                            Grid.Column="0"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="{x:Bind Strings.Get('Toolbox_Url_Placeholder'), Mode=OneWay}"
                            TextChanged="UrlBox_TextChanged" />
                        <Button
                            x:Name="PasteButton"
                            Grid.Column="1"
                            Click="PasteButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Toolbox_Btn_Paste_Tip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE77F;" FontSize="14" />
                                <TextBlock Text="{x:Bind Strings.Get('Toolbox_Btn_Paste'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="StartButton"
                            Grid.Column="2"
                            Style="{StaticResource AuroraGlassButtonStyle}"
                            Click="StartButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="{x:Bind Strings.Get('Toolbox_Btn_Start'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="ProbePanel" Spacing="2" Visibility="Collapsed">
                        <TextBlock
                            x:Name="ProbeNameText"
                            Style="{StaticResource FieldValueTextStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="ProbeMetaText"
                            Style="{StaticResource FieldLabelTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Toolbox_Threads_Label'), Mode=OneWay}"
                            Style="{StaticResource FieldLabelTextStyle}" />
                        <NumberBox
                            x:Name="ThreadBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="120"
                            Minimum="1"
                            Maximum="256"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="ThreadBox_ValueChanged" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Toolbox_Threads_Hint'), Mode=OneWay}"
                            Style="{StaticResource FieldLabelTextStyle}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Toolbox_Dir_Label'), Mode=OneWay}"
                            Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock
                            x:Name="DownloadDirText"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button x:Name="ChangeDirButton" Click="ChangeDirButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Toolbox_Btn_ChangeDir'), Mode=OneWay}" />
                            </Button>
                            <Button x:Name="OpenDirButton" Click="OpenDirButton_Click">
                                <TextBlock Text="{x:Bind Strings.Get('Toolbox_Btn_OpenDir'), Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 任务列表 -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="{x:Bind Strings.Get('Toolbox_Tasks_Title'), Mode=OneWay}"
                    Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock
                    x:Name="EmptyHint"
                    Text="{x:Bind Strings.Get('Toolbox_Empty'), Mode=OneWay}"
                    Style="{StaticResource FieldLabelTextStyle}"
                    TextWrapping="Wrap" />

                <ListView
                    x:Name="TaskList"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadTaskItem">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind FileName, Mode=OneWay}"
                                            Style="{StaticResource FieldValueTextStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            Style="{StaticResource FieldLabelTextStyle}"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar
                                        Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                        Maximum="100" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind SizeText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind SpeedText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind RemainingText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <TextBlock
                                        Text="{x:Bind ErrorText, Mode=OneWay}"
                                        Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Click="PauseClick"
                                            IsEnabled="{x:Bind CanPause, Mode=OneWay}">
                                            <TextBlock Text="{loc:Localize Key=Dl_Btn_Pause}" />
                                        </Button>
                                        <Button
                                            Click="ResumeClick"
                                            IsEnabled="{x:Bind CanResume, Mode=OneWay}">
                                            <TextBlock Text="{loc:Localize Key=Dl_Btn_Resume}" />
                                        </Button>
                                        <Button
                                            Click="CancelClick"
                                            IsEnabled="{x:Bind CanCancel, Mode=OneWay}">
                                            <TextBlock Text="{loc:Localize Key=Dl_Btn_Cancel}" />
                                        </Button>
                                        <Button Click="OpenFolderClick">
                                            <TextBlock Text="{loc:Localize Key=Dl_Btn_OpenFolder}" />
                                        </Button>
                                        <Button Click="RemoveClick">
                                            <TextBlock Text="{loc:Localize Key=Dl_Btn_Remove}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
