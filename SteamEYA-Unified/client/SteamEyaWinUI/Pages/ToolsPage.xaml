<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamEyaWinUI.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <StackPanel MaxWidth="820" Spacing="14" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <InfoBar x:Name="PageInfoBar" IsClosable="True" IsOpen="False" />

            <!-- 运行状态 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="StatusTitle"
                            Grid.Column="0"
                            Style="{StaticResource SectionTitleTextStyle}"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="1"
                            Style="{StaticResource AuroraGlassButtonStyle}"
                            Click="OnRefreshClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <TextBlock x:Name="RefreshLabel" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="StudentLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="StudentValue" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValueTextStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BypassLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="BypassValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValueTextStyle}" />
                        <TextBlock x:Name="BroadcastLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="BroadcastValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValueTextStyle}" />
                        <TextBlock x:Name="HotkeyLabel" Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="HotkeyValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValueTextStyle}" />
                    </Grid>

                    <TextBlock
                        x:Name="DetailText"
                        Style="{StaticResource FieldLabelTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- 绕过开关 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="BypassTitle" Style="{StaticResource SectionTitleTextStyle}" />
                    <ToggleSwitch x:Name="BypassSwitch" Toggled="OnBypassToggled" />
                    <TextBlock x:Name="BypassDesc" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 广播窗口置顶 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AllowTopTitle" Style="{StaticResource SectionTitleTextStyle}" />
                    <ToggleSwitch x:Name="AllowTopSwitch" Toggled="OnAllowTopToggled" />
                    <TextBlock x:Name="AllowTopDesc" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 老板键 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="BossTitle" Style="{StaticResource SectionTitleTextStyle}" />
                    <ToggleSwitch x:Name="BossSwitch" Toggled="OnBossToggled" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="BossHotkeyLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox
                            x:Name="HotkeyBox"
                            Grid.Column="1"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            KeyDown="OnHotkeyKeyDown" />
                        <Button
                            x:Name="RecordButton"
                            Grid.Column="2"
                            Style="{StaticResource AuroraGlassButtonStyle}"
                            Click="OnRecordClick" />
                    </Grid>

                    <TextBlock x:Name="BossDesc" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />

                    <Button
                        x:Name="TestButton"
                        Style="{StaticResource AuroraGlassButtonStyle}"
                        Click="OnTestClick" />
                </StackPanel>
            </Border>

            <!-- 保队友 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PanicTitle" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="PanicDesc" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />
                    <!-- 两步确认：第一次点击变「确认保队友」并在右侧出现取消，再点同一位置才执行。 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PanicButton"
                            MinWidth="200"
                            Style="{StaticResource AuroraGlassButtonStyle}"
                            Click="OnPanicClick" />
                        <Button
                            x:Name="PanicCancelButton"
                            Click="OnPanicCancelClick"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
