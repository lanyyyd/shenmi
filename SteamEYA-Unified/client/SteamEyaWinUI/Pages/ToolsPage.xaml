<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamEyaWinUI.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <StackPanel MaxWidth="820" Spacing="14" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <InfoBar x:Name="PageInfoBar" IsClosable="True" IsOpen="False" />

            <!-- 内置助手状态 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HelperTitle" Style="{StaticResource SectionTitleTextStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="HelperLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="HelperValue" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValueTextStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="InjectionLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="InjectionValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValueTextStyle}" />
                        <TextBlock x:Name="StudentLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="StudentValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValueTextStyle}" />
                        <TextBlock x:Name="VersionLabel" Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock x:Name="VersionValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValueTextStyle}" />
                    </Grid>

                    <TextBlock x:Name="HelperDesc" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ShowButton" Style="{StaticResource AuroraGlassButtonStyle}" Click="OnShowClick" />
                        <Button x:Name="ConfigButton" Style="{StaticResource AuroraGlassButtonStyle}" Click="OnConfigClick" />
                        <Button x:Name="FolderButton" Style="{StaticResource AuroraGlassButtonStyle}" Click="OnFolderClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 注入开关 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="InjectionTitle" Style="{StaticResource SectionTitleTextStyle}" />
                    <ToggleSwitch x:Name="InjectionSwitch" Toggled="OnInjectionToggled" />
                    <TextBlock x:Name="InjectionDesc" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />
                    <Button x:Name="DetachButton" Style="{StaticResource AuroraGlassButtonStyle}" Click="OnDetachClick" />
                </StackPanel>
            </Border>

            <!-- 快捷键 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="HotkeyTitle" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="HotkeyDesc" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />

                    <!-- 伪装全屏：客户端注册热键后转发给原版助手执行 -->
                    <ToggleSwitch x:Name="FullscreenHotkeySwitch" Toggled="OnFullscreenHotkeyToggled" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="FullscreenHotkeyBox"
                            Grid.Column="0"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            KeyDown="OnFullscreenHotkeyKeyDown" />
                        <Button
                            x:Name="FullscreenRecordButton"
                            Grid.Column="1"
                            Style="{StaticResource AuroraGlassButtonStyle}"
                            Click="OnFullscreenRecordClick" />
                    </Grid>

                    <!-- 老板键：把当前广播窗口拉成全屏并激活，可选同时隐藏茶π -->
                    <ToggleSwitch x:Name="BossHotkeySwitch" Toggled="OnBossHotkeyToggled" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="BossHotkeyBox"
                            Grid.Column="0"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            KeyDown="OnBossHotkeyKeyDown" />
                        <Button
                            x:Name="BossRecordButton"
                            Grid.Column="1"
                            Style="{StaticResource AuroraGlassButtonStyle}"
                            Click="OnBossRecordClick" />
                        <Button
                            x:Name="BossTestButton"
                            Grid.Column="2"
                            Style="{StaticResource AuroraGlassButtonStyle}"
                            Click="OnBossTestClick" />
                    </Grid>
                    <ToggleSwitch x:Name="BossHideSwitch" Toggled="OnBossHideToggled" />
                </StackPanel>
            </Border>

            <!-- 退出行为 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CloseWithAppTitle" Style="{StaticResource SectionTitleTextStyle}" />
                    <ToggleSwitch x:Name="CloseWithAppSwitch" Toggled="OnCloseWithAppToggled" />
                    <TextBlock x:Name="CloseWithAppDesc" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 保队友 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PanicTitle" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="PanicDesc" Style="{StaticResource FieldLabelTextStyle}" TextWrapping="Wrap" />
                    <!-- 两步确认：第一次点击变「确认保队友」并在右侧出现取消，再点同一位置才执行。 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PanicButton"
                            MinWidth="200"
                            Style="{StaticResource AuroraGlassButtonStyle}"
                            Click="OnPanicClick" />
                        <Button
                            x:Name="PanicCancelButton"
                            Click="OnPanicCancelClick"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
