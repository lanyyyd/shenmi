<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamEyaWinUI.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SteamEyaWinUI.Pages">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左栏：连接状态 / 局域网互传 / 会话与用户 ================= -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 连接状态 -->
            <StackPanel Grid.Row="0" Padding="16,14,16,10" Spacing="2">
                <TextBlock
                    x:Name="HeaderText"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse
                        x:Name="ConnDot"
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock
                        x:Name="ConnText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- 局域网互传面板 -->
            <Expander
                Grid.Row="1"
                Margin="12,0,12,8"
                HorizontalAlignment="Stretch"
                Header="{x:Bind Strings.Get('Chat_Lan_Title'), Mode=OneWay}">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="LanSelfText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ListView
                        x:Name="LanPeersList"
                        MaxHeight="140"
                        SelectionMode="None">
                    </ListView>
                    <TextBlock
                        x:Name="LanEmptyText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddPeerButton" Click="AddPeer_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock x:Name="AddPeerText" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshLanButton" Click="RefreshLan_Click">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- 群聊入口 -->
            <Button
                x:Name="GroupButton"
                Grid.Row="2"
                Margin="12,0,12,6"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="Group_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                    <TextBlock x:Name="GroupText" />
                    <Border
                        x:Name="GroupBadge"
                        MinWidth="18"
                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                        CornerRadius="9"
                        Padding="5,1"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="GroupBadgeText"
                            Foreground="White"
                            FontSize="11"
                            HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Button>

            <!-- 用户列表 -->
            <ListView
                x:Name="UsersList"
                Grid.Row="3"
                SelectionMode="Single"
                SelectionChanged="UsersList_SelectionChanged">
            </ListView>
        </Grid>

        <!-- ================= 右栏：会话 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 会话标题 -->
            <Border
                Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="20,14">
                <TextBlock x:Name="RoomTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Border>

            <!-- 消息列表 -->
            <ListView
                x:Name="MessagesList"
                Grid.Row="1"
                Padding="12,8"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ChatMessageVm">
                        <Grid Margin="0,6" HorizontalAlignment="{x:Bind RowAlign}">
                            <StackPanel MaxWidth="600" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind HeaderText}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Button
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        FontSize="12"
                                        Visibility="{x:Bind RecallVisibility}"
                                        Content="{x:Bind RecallLabel}" />
                                </StackPanel>
                                <Border
                                    Background="{x:Bind BubbleBrush}"
                                    CornerRadius="8"
                                    Padding="10,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind DisplayContent}"
                                            Foreground="{x:Bind ContentForeground}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind TextVisibility}" />
                                        <Image
                                            Source="{x:Bind Image}"
                                            MaxWidth="360"
                                            MaxHeight="360"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind ImageVisibility}" />
                                        <Button
                                            Visibility="{x:Bind FileVisibility}"
                                            HorizontalAlignment="Left"
                                            Content="{x:Bind FileLabel}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 输入区 -->
            <Grid
                Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="16,12"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="InputBox"
                    Grid.Column="0"
                    MaxHeight="120"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    KeyDown="InputBox_KeyDown" />
                <Button
                    x:Name="ImageButton"
                    Grid.Column="1"
                    Click="Image_Click"
                    VerticalAlignment="Bottom">
                    <FontIcon FontSize="16" Glyph="&#xEB9F;" />
                </Button>
                <Button
                    x:Name="FileButton"
                    Grid.Column="2"
                    Click="File_Click"
                    VerticalAlignment="Bottom">
                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                </Button>
                <Button
                    x:Name="SendButton"
                    Grid.Column="3"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Send_Click"
                    VerticalAlignment="Bottom">
                    <FontIcon FontSize="16" Glyph="&#xE724;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
